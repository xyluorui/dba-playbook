---
import { posix } from 'node:path';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from './Icon.astro';
import RichText from './RichText.astro';
import TopicWorkspace from './TopicWorkspace.astro';
import { articlesByPath, directoriesByPath, sectionLabels, statusLabel, topicScope, type ContentDirectory } from '../lib/content';
import { relativeHref } from '../lib/links';

interface Props {
  directory: ContentDirectory;
}

const { directory } = Astro.props;
const { path, section } = directory;
const scope = path.startsWith('docs/') ? topicScope(path) : undefined;
const href = (target: string) => relativeHref(path, target);
const isMysql = path === 'docs/02-mysql/index.html';
const isRedis = path === 'docs/04-redis/index.html';
const isLabs = path === 'labs/index.html';
const isPractice = path === 'practice/index.html';
const isGeneralKnowledge = path.startsWith('docs/') && section === 'practice';
const parent = directoriesByPath.get(posix.join(posix.dirname(posix.dirname(path)), 'index.html'));
const children = directory.childPaths.map((entry) => directoriesByPath.get(entry)!);
const overview = isMysql ? articlesByPath.get('docs/02-mysql/overview.html') : undefined;
const lab = isLabs ? articlesByPath.get('labs/demo-sql-journey.html') : undefined;
const articles = directory.articlePaths.map((entry) => articlesByPath.get(entry)!)
  .filter((entry) => entry !== overview && entry !== lab);
const isEmptyDirectory = !isLabs && articles.length === 0 && children.length === 0;
const hasShortNotesPanel = isEmptyDirectory && Boolean(scope);
const title = isLabs ? '交互实验室' : directory.title;
const description = isMysql ? '沿着一条 SQL，从客户端读到存储引擎，也可以按专题查阅 MySQL 的核心机制。'
  : isRedis ? '按主题查阅 Redis 的架构、持久化、高可用与日常运维。'
  : isLabs ? '暂停在任意一步，观察数据库组件之间的交互，并用证据核对当前步骤。'
  : directory.description;
const topicsHeading = isMysql ? '学习章节' : isRedis ? '知识专题' : isPractice ? '实战分类' : '下级目录';
---

<SiteLayout title={title} description={description} section={isGeneralKnowledge ? undefined : section} path={path}>
  <div class:list={['page-container', 'directory-page', { 'redis-directory': isRedis }]}>
    <nav aria-label="面包屑" class="directory-crumbs">
      <a href={href('index.html')}>首页</a>
      {parent && <a href={href(parent.path)}>{parent.title}</a>}
      <span aria-current="page">{title}</span>
    </nav>

    <TopicWorkspace {path} {scope}>
      <header class="directory-hero">
        <p class="eyebrow">{isMysql ? 'MYSQL / 知识库' : isRedis ? 'REDIS / 知识库' : isLabs ? 'DBA / LABS' : isGeneralKnowledge ? 'DBA / 知识库' : sectionLabels[section]}</p>
        <h1>{title}</h1>
        {description && <p class="directory-description">{description}</p>}
        {overview && (
          <div class="directory-actions">
            <a class="primary-link" href={href(overview.path)}>打开 MySQL 学习地图 <Icon name="arrow" size={17} /></a>
            <a class="secondary-link" href={href('labs/index.html')}>查看相关实验</a>
          </div>
        )}
      </header>

      {lab && (
        <section aria-labelledby="lab-title" class="lab-feature">
          <div class="lab-feature-copy">
            <div class="lab-feature-kicker"><Icon name="flask" size={17} /> MySQL · 单步观察</div>
            <h2 id="lab-title">一条 SELECT 的旅程</h2>
            <p>一条查询经过连接、解析、优化和 InnoDB 时，各层分别做了什么？在拓扑和时序视图中逐步跟踪。</p>
            <div class="directory-actions">
              <a class="primary-link" href={href('labs/app/index.html')}><Icon name="play" size={17} /> 开始实验</a>
              <a class="secondary-link" href={href(lab.path)}>阅读静态步骤</a>
            </div>
          </div>
          <div class="lab-route" aria-label="实验观察顺序">
            <div><span>01</span> 连接层</div>
            <div><span>02</span> SQL 层</div>
            <div><span>03</span> InnoDB</div>
          </div>
        </section>
      )}

      {isLabs && !articles.some((article) => article.meta.database.toLowerCase() === 'redis') && (
        <section class="empty-panel" aria-labelledby="redis-labs-heading">
          <h2 id="redis-labs-heading">Redis 实验</h2>
          <p>场景待补充。可以先从 Redis 专区浏览对应主题。</p>
          <a class="text-link" href={href('docs/04-redis/index.html')}>浏览 Redis 专区 <Icon name="arrow" size={16} /></a>
        </section>
      )}

      {articles.length > 0 && (
        <section class="directory-section" aria-labelledby="directory-articles-heading">
          <h2 id="directory-articles-heading">{isLabs ? '其他实验' : '本目录文章'}</h2>
          <ul class="directory-article-list">
            {articles.map((article) => (
              <li>
                <h3><a href={href(article.path)}>{article.title} <Icon name="arrow" size={17} /></a></h3>
                {article.description && <p>{article.description}</p>}
                {article.indexable && (
                  <p class="directory-entry-meta">
                    {article.meta.category && <span>{article.meta.category}</span>}
                    {article.meta.status && <span>{statusLabel(article.meta.status)}</span>}
                    {article.meta.date && <time datetime={article.meta.date}>{article.meta.date}</time>}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}

      {children.length > 0 && (
        <section class="directory-section" aria-labelledby="directory-topics-heading">
          <div class="directory-section-heading">
            <h2 id="directory-topics-heading">{topicsHeading}</h2>
            {(isMysql || isRedis) && <span>{children.length} 个主题</span>}
          </div>
          <ul class="topic-cards">
            {children.map((topic) => {
              const numbered = isMysql ? /^(\d+)\s*·\s*(.+)$/.exec(topic.title) : null;
              return (
                <li class="topic-card">
                  <div class="topic-card-top">
                    {numbered && <span class="topic-number">{numbered[1]}</span>}
                    {(isMysql || isRedis) && (
                      <span class:list={['topic-state', { 'has-articles': topic.articleCount > 0 }]}>
                        {topic.articleCount > 0 ? `${topic.articleCount} 篇文章` : '待补充'}
                      </span>
                    )}
                  </div>
                  <h3><a href={href(topic.path)}>{numbered?.[2] ?? topic.title} <Icon name="diagonal" size={17} /></a></h3>
                  {topic.description && <p>{topic.description}</p>}
                  {(isMysql || isRedis) && topic.articlePaths.length > 0 && (
                    <ul class="topic-card-articles">
                      {topic.articlePaths.map((entry) => (
                        <li><a href={href(entry)}>{articlesByPath.get(entry)!.title}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {isEmptyDirectory && (
        <section class="empty-panel">
          <h2>内容待补充</h2>
          <p>目录已建立。新增内容后，可在这里直接查看。</p>
        </section>
      )}

      {isPractice && <a class="text-link" href={href('templates/index.html')}>查看记录模板 <Icon name="arrow" size={16} /></a>}

      {directory.readme && !isMysql && !isRedis && (
        <div class:list={['directory-notes-area', { 'short-notes-panel': hasShortNotesPanel }]}>
          <details class="directory-notes">
            <summary>{isLabs ? '场景数据与维护说明' : '目录说明与资料'}</summary>
            <div
              class="directory-notes-body"
              tabindex={hasShortNotesPanel ? 0 : undefined}
              role={hasShortNotesPanel ? 'region' : undefined}
              aria-label={hasShortNotesPanel ? '目录说明正文' : undefined}
            >
              <RichText html={directory.readme} />
            </div>
          </details>
        </div>
      )}
    </TopicWorkspace>
  </div>
</SiteLayout>

<style>
  .directory-page { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .directory-crumbs { display: flex; flex-wrap: wrap; gap: .25rem .62rem; margin-bottom: 1.55rem; font-size: .84rem; color: var(--muted); }
  .directory-crumbs > :not(:first-child)::before { content: '/'; margin-inline-end: .62rem; color: var(--muted); opacity: .7; }
  .directory-crumbs [aria-current='page'] { color: var(--text); }
  .directory-crumbs a:hover { color: var(--accent); }
  .directory-hero { padding: clamp(1rem, 3vw, 2rem) 0 clamp(1.4rem, 4vw, 3rem); }
  .directory-hero h1 { margin: .4rem 0 .7rem; font: 760 clamp(2.6rem, 7vw, 5rem)/1.02 var(--serif); letter-spacing: -.04em; }
  .redis-directory .directory-hero .eyebrow { color: var(--redis); }
  .directory-description { max-width: 46rem; margin: 0; color: var(--muted); font-size: clamp(.98rem, 2vw, 1.17rem); }
  .directory-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; margin-top: 1.25rem; }
  .directory-section { margin-top: 1.55rem; }
  .directory-section h2 { margin: 0 0 .9rem; font-size: 1.4rem; }
  .directory-section-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; border-bottom: 1px solid var(--line); margin-bottom: 1rem; }
  .directory-section-heading > span { color: var(--muted); font: .8rem var(--mono); }
  .topic-cards, .directory-article-list { padding: 0; margin: 0; list-style: none; }
  .topic-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .85rem; }
  .topic-card { min-width: 0; padding: 1rem 1.1rem; background: var(--surface); border: 1px solid var(--line); border-radius: .6rem; }
  .topic-card-top { display: flex; align-items: center; justify-content: space-between; gap: .6rem; }
  .topic-card-top:empty { display: none; }
  .topic-number { color: var(--accent); font: 650 .82rem var(--mono); }
  .topic-state { margin-inline-start: auto; padding: .13rem .43rem; color: var(--muted); background: var(--surface-raised); border-radius: .35rem; font-size: .73rem; }
  .topic-state.has-articles { color: var(--accent); background: var(--accent-soft); }
  .topic-card h3, .directory-article-list h3 { margin: .55rem 0 .3rem; font-size: 1.02rem; }
  .topic-card h3 a, .directory-article-list h3 a { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; }
  .topic-card h3 svg, .directory-article-list h3 svg { align-self: center; flex: none; color: var(--muted); }
  .topic-card a:hover, .directory-article-list a:hover { color: var(--accent); }
  .topic-card p, .directory-article-list p { color: var(--muted); font-size: .88rem; margin: 0; }
  .topic-card-articles { margin: .55rem 0 0; padding: .65rem 0 0; border-top: 1px solid var(--line); list-style: none; font-size: .86rem; }
  .topic-card-articles a { color: var(--accent); text-decoration: underline; text-underline-offset: .18em; }
  .topic-card-articles li + li { margin-top: .3rem; }
  .directory-article-list li { padding: .85rem 0; border-top: 1px solid var(--line); }
  .directory-article-list .directory-entry-meta { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: .45rem; font-size: .75rem; }
  .empty-panel, .directory-notes-area { margin-top: 1.25rem; }
  .empty-panel, .directory-notes { padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: .6rem; }
  .empty-panel h2 { margin: 0 0 .3rem; font-size: 1.05rem; }
  .empty-panel p { margin: 0; color: var(--muted); font-size: .9rem; }
  .empty-panel .text-link, .directory-page > .text-link { margin-top: .65rem; }
  .directory-notes summary { cursor: pointer; color: var(--muted); font-weight: 650; }
  .directory-notes-body { margin-top: .9rem; overflow-x: auto; }
  .short-notes-panel {
    --notes-body-height: clamp(10rem, 30dvh, 18rem);
    /* Keep the shared grid height stable while the notes are folded. */
    min-block-size: calc(var(--notes-body-height) + 5rem);
  }
  .short-notes-panel .directory-notes-body { max-block-size: var(--notes-body-height); overflow: auto; }
  .directory-notes-body:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .lab-feature { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr); align-items: center; gap: clamp(1rem, 5vw, 4rem); background: var(--surface); border: 1px solid var(--line); border-radius: .75rem; padding: clamp(1rem, 4vw, 2.4rem); }
  .lab-feature h2 { margin: .45rem 0 .35rem; font: 750 clamp(1.75rem, 4vw, 2.65rem)/1.1 var(--serif); }
  .lab-feature-copy > p { margin: 0; color: var(--muted); }
  .lab-feature-kicker { display: flex; gap: .45rem; align-items: center; color: var(--accent); font: 650 .82rem var(--mono); }
  .lab-route { display: grid; gap: .5rem; }
  .lab-route div { padding: .46rem .65rem; border: 1px solid var(--line); border-radius: .4rem; background: var(--surface-raised); font-size: .88rem; }
  .lab-route span { display: inline-block; min-width: 2rem; font-family: var(--mono); color: var(--accent); }
  @media (max-width: 880px) {
    .topic-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 580px) {
    .topic-cards, .lab-feature { grid-template-columns: minmax(0, 1fr); }
  }
</style>
