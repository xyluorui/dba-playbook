---
import Icon from './Icon.astro';
import TopicLinks from './TopicLinks.astro';
import { articlesByPath, directoriesByPath, type ContentDirectory } from '../lib/content';
import { relativeHref } from '../lib/links';

interface Props {
  directory: ContentDirectory;
  path: string;
  includeOverview?: boolean;
  insideGroup?: boolean;
}

const { directory, path, includeOverview = false, insideGroup = false } = Astro.props;
const articles = directory.articlePaths.map((entry) => articlesByPath.get(entry)!);
const chapters = directory.childPaths.map((entry) => directoriesByPath.get(entry)!);
const isDatabaseRoot = directory.path === 'docs/02-mysql/index.html' || directory.path === 'docs/04-redis/index.html';
const solutions = isDatabaseRoot ? chapters.find((chapter) => chapter.path.endsWith('/solutions/index.html')) : undefined;
const basicDirectory = { ...directory, childPaths: directory.childPaths.filter((entry) => entry !== solutions?.path) };
const inSolutions = solutions && path.startsWith(solutions.path.slice(0, -'index.html'.length));
---

{isDatabaseRoot && !insideGroup ? (
  <ul class="topic-links">
    <li><details class="topic-children" data-topic-path={`${directory.path}#basics`} open={!inSolutions}>
      <summary><span>基础原理与核心机制</span><Icon name="chevron" size={16} /></summary>
      <TopicLinks directory={basicDirectory} {path} insideGroup />
    </details></li>
    {solutions && <li><details class="topic-children" data-topic-path={solutions.path} open={inSolutions}>
      <summary class:list={{ 'active-topic': inSolutions }}><span>{solutions.title}</span><Icon name="chevron" size={16} /></summary>
      <TopicLinks directory={solutions} {path} includeOverview />
    </details></li>}
  </ul>
) : (articles.length > 0 || chapters.length > 0) && (
  <ul class="topic-links">
    {includeOverview && (
      <li>
        <a
          href={relativeHref(path, directory.path)}
          aria-label={`章节概览 · ${directory.title}`}
          aria-current={path === directory.path ? 'page' : undefined}
        >章节概览</a>
      </li>
    )}
    {articles.map((article) => (
      <li>
        <a href={relativeHref(path, article.path)} aria-current={path === article.path ? 'page' : undefined}>{article.title}</a>
      </li>
    ))}
    {chapters.map((chapter) => {
      const active = path.startsWith(chapter.path.slice(0, -'index.html'.length));
      const hasChildren = chapter.childPaths.length > 0 || chapter.articlePaths.length > 0;
      return (
        <li>
          {hasChildren ? (
            <details class="topic-children" data-topic-path={chapter.path} open={active}>
              <summary class:list={{ 'active-topic': active }}>
                <span>{chapter.title}</span>
                <Icon name="chevron" size={16} />
              </summary>
              <TopicLinks directory={chapter} {path} includeOverview />
            </details>
          ) : (
            <a href={relativeHref(path, chapter.path)} aria-current={path === chapter.path ? 'page' : undefined}>{chapter.title}</a>
          )}
        </li>
      );
    })}
  </ul>
)}
